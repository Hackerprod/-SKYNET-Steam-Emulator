<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The one SKYNET developer CLI (single project, two targets of the same sources):
      net8.0-windows  skynet-gc.exe   the command line (capture, ui, analyze, ...)
      net472          skynet-gc-hook.dll  the EasyHook payload injected into dota2.exe by `capture`
                                       (Capture\GcHookEntryPoint.cs); EasyHook loads managed payloads
                                       through the .NET Framework CLR, exactly like the launcher's
                                       own injector (SKYNET Steam Client\Services\DllInjector.cs).
    Building the CLI also builds the hook and copies it to hook\ next to the exe.
  -->
  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net472</TargetFrameworks>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>SKYNET.Gc</RootNamespace>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <!-- Only the .NET 10 runtime may be installed on a dev machine; the net8 CLI must still start there. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <OutputType>Exe</OutputType>
    <AssemblyName>skynet-gc</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net472'">
    <OutputType>Exe</OutputType>
    <AssemblyName>skynet-gc-hook</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EasyHook" Version="2.7.7097" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="protobuf-net" Version="3.2.56" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <ProjectReference Include="..\..\SKYNET server\SKYNET server.csproj" />
    <Compile Remove="Capture\GcHookEntryPoint.cs;Capture\HookMain.cs;Capture\CaptureCommand.cs" />
    <!-- Builds (and restores) the tracer payload; it is not referenced as a library, only copied to hook\ below. -->
    <ProjectReference Include="..\SkynetIfaceHook\SkynetIfaceHook.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" SetTargetFramework="TargetFramework=net472" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Compile Remove="**\*.cs" />
    <Compile Include="Capture\GcHookEntryPoint.cs;Capture\HookMain.cs;Capture\CaptureCommand.cs;DotaLocator.cs" />
  </ItemGroup>

  <Target Name="BuildAndCopyHook" AfterTargets="Build" Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Build" Properties="TargetFramework=net472;NoRestore=true;Configuration=$(Configuration)" />
    <ItemGroup>
      <HookFiles Include="$(MSBuildProjectDirectory)\bin\$(Configuration)\net472\skynet-gc-hook.exe;$(MSBuildProjectDirectory)\bin\$(Configuration)\net472\skynet-gc-hook.exe.config;$(MSBuildProjectDirectory)\bin\$(Configuration)\net472\EasyHook*.dll;$(MSBuildProjectDirectory)\bin\$(Configuration)\net472\EasyHook*Svc.exe;$(MSBuildProjectDirectory)\bin\$(Configuration)\net472\EasyLoad*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(HookFiles)" DestinationFolder="$(OutDir)hook" />
    <ItemGroup>
      <IfaceHookFiles Include="$(MSBuildProjectDirectory)\..\SkynetIfaceHook\bin\$(Configuration)\net472\skynet-iface-hook.exe;$(MSBuildProjectDirectory)\..\SkynetIfaceHook\bin\$(Configuration)\net472\skynet-iface-hook.exe.config" />
      <IfaceSpecFiles Include="$(MSBuildProjectDirectory)\..\SkynetIfaceHook\bin\$(Configuration)\net472\meta\*.txt" />
    </ItemGroup>
    <Copy SourceFiles="@(IfaceHookFiles)" DestinationFolder="$(OutDir)hook" />
    <Copy SourceFiles="@(IfaceSpecFiles)" DestinationFolder="$(OutDir)hook\meta" />
</Target>
</Project>



